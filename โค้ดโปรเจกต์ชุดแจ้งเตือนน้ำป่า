  notified180 = true;
  notified150 = notified130 = notified100 = notified80 = notified50 = notified30 = true;

} else if (waterLevel >= 150 && !notified150 && !notified180 && !notified190) {
  bot.sendMessage(chatID, "🌊 [ระดับน้ำ 150 cm]\nน้ำสูงมากและเพิ่มขึ้นอย่างรวดเร็ว\n\n⚠️ เสี่ยงท่วมบ้านเรือนและถนนสายหลัก", "");
  notified150 = true;
  notified130 = notified100 = notified80 = notified50 = notified30 = true;

} else if (waterLevel >= 130 && !notified130 && !notified150 && !notified180 && !notified190) {
  bot.sendMessage(chatID, "🌊 [ระดับน้ำ 130 cm]\nน้ำเริ่มเข้าขั้นอันตราย\n\n⚠️ พื้นที่ลุ่มต่ำอาจถูกน้ำท่วม", "");
  notified130 = true;
  notified100 = notified80 = notified50 = notified30 = true;

} else if (waterLevel >= 100 && !notified100 && !notified130 && !notified150 && !notified180 && !notified190) {
  bot.sendMessage(chatID, "🌊 [ระดับน้ำ 100 cm]\nน้ำสูงผิดปกติ!\n\n⚠️ บ้านเรือนชั้นล่างเสี่ยงน้ำท่วม", "");
  notified100 = true;
  notified80 = notified50 = notified30 = true;

} else if (waterLevel >= 80 && !notified80 && !notified100 && !notified130 && !notified150 && !notified180 && !notified190) {
  bot.sendMessage(chatID, "🌊 [ระดับน้ำ 80 cm]\nน้ำสูงถึงจุดเสี่ยงแล้ว!\n\n⚠️ อาจเกิดน้ำท่วมในพื้นที่ต", "");
  notified80 = true;
  notified50 = notified30 = true;

} else if (waterLevel >= 50 && !notified50 && !notified80 && !notified100 && !notified130 && !notified150 && !notified180 && !notified190) {
  bot.sendMessage(chatID, "🌊 [ระดับน้ำ 50 cm]\nน้ำเริ่มสูงขึ้น\n\n⚠️ พื้นที่ต่ำเริ่มมีน้ำขัง", "");
  notified50 = true;
  notified30 = true;

} else if (waterLevel >= 30 && !notified30 && !notified50 && !notified80 && !notified100 && !notified130 && !notified150 && !notified180 && !notified190) {
  bot.sendMessage(chatID, "🌊 [ระดับน้ำ 30 cm]\nเริ่มมีน้ำปริมาณมากขึ้น\n\n⚠️ โปรดติดตามสถานการณ์", "");
  notified30 = true;
}

  // ==== รีเซตการแจ้งเตือนเมื่อระดับน้ำลดลง ====
  if (waterLevel < 30) {
    notified30 = notified50 = notified80 = notified100 = 
    notified130 = notified150 = notified180 = notified190 = false;
  } else if (waterLevel < 50) {
    notified50 = notified80 = notified100 = notified130 = notified150 = notified180 = notified190 = false;
  } else if (waterLevel < 80) {
    notified80 = notified100 = notified130 = notified150 = notified180 = notified190 = false;
  } else if (waterLevel < 100) {
    notified100 = notified130 = notified150 = notified180 = notified190 = false;
  } else if (waterLevel < 130) {
    notified130 = notified150 = notified180 = notified190 = false;
  } else if (waterLevel < 150) {
    notified150 = notified180 = notified190 = false;
  } else if (waterLevel < 180) {
    notified180 = notified190 = false;
  } else if (waterLevel < 190) {
    notified190 = false;
  }

  // ==== วัดปริมาณฝน ====
  rainAmount = rainCount * 0.2; // 1 click = 0.2 mm

  Serial.print("🌧 ปริมาณน้ำฝน: ");
  Serial.print(rainCount);
  Serial.print(" clicks → ");
  Serial.print(rainAmount, 1);
  Serial.println(" mm");

  // ==== แจ้งเตือนระดับฝน ====
  int currentRainLevel = 0;
  if (rainAmount >= 0.1 && rainAmount <= 10.0) currentRainLevel = 1;
  else if (rainAmount > 10.0 && rainAmount <= 35.0) currentRainLevel = 2;
  else if (rainAmount > 35.0 && rainAmount <= 90.0) currentRainLevel = 3;
  else if (rainAmount > 90.0) currentRainLevel = 4;

  if (rainIsFalling && currentRainLevel != 0 && currentRainLevel != lastRainLevel) {
    switch (currentRainLevel) {
      case 1:
        bot.sendMessage(chatID, "☔ ขณะนี้มีฝนตกเล็กน้อย อาจมีน้ำขังเล็กน้อยในบางพื้นที่ ปริมาณน้ำฝน " + String(rainAmount, 1) + " mm.", "");
        break;
      case 2:
        bot.sendMessage(chatID, "🌧 ขณะนี้ฝนตกปานกลาง ถนนลื่น โปรดขับขี่ด้วยความระมัดระวัง ปริมาณน้ำฝน " + String(rainAmount, 1) + " mm.", "");
