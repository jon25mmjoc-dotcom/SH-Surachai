#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <UniversalTelegramBot.h>
#include <ArduinoJson.h>

// ==== Pin Configuration ====
#define TRIG_PIN 5      // Ultrasonic Sensor - Trigger
#define ECHO_PIN 18     // Ultrasonic Sensor - Echo
#define RAIN_PIN 4      // Tipping Bucket - Signal

// ==== WiFi and Telegram ====
const char* ssid = "flood.lp.360";
const char* password = "50094106";
const char* botToken = "7546198707:AAHDZI57JpiyE4urUkQA47GmOKBJpOzbpCI"; // ใส่ token ของคุณ
const char* chatID = "-1002867064553";

// ==== Water Level Variables ====
long duration;
float distance;
float waterLevel;
bool notified30 = false;
bool notified50 = false;
bool notified80 = false;
bool notified100 = false;
bool notified130 = false;
bool notified150 = false;
bool notified180 = false;
bool notified190 = false;

// ==== Rainfall Variables ====
volatile int rainCount = 0;
volatile unsigned long lastInterruptTime = 0;
float rainAmount = 0;
unsigned long lastRainClickTime = 0;
bool rainIsFalling = false;
int lastRainLevel = 0; // 0 = ยังไม่แจ้ง, 1 = เล็กน้อย, 2 = ปานกลาง, 3 = หนัก, 4 = หนักมาก

// ==== Telegram Bot ====
WiFiClientSecure client;
UniversalTelegramBot bot(botToken, client);

// ==== Interrupt: Rain Click ====
void IRAM_ATTR rainISR() {
  unsigned long currentTime = millis();
  if (currentTime - lastInterruptTime > 100) {
    rainCount++;
    lastRainClickTime = millis();
    lastInterruptTime = currentTime;
    Serial.println("💧 Rain click detected!");
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  pinMode(RAIN_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(RAIN_PIN), rainISR, CHANGE);

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println(" Connected!");
  client.setInsecure();

  bot.sendMessage(chatID, "☁️ ระบบเริ่มทำงาน: เครื่องตรวจวัดระดับน้ำป่าไหลหลากและปริมาณน้ำฝน", "");
}

void loop() {
  // ==== วัดระดับน้ำ ====
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  duration = pulseIn(ECHO_PIN, HIGH);
  distance = duration * 0.034 / 2;
  waterLevel = 200.0 - distance;   // ความสูงที่ติดเซ็นเซอร์ค์ 200 cm

  Serial.print("📏 ระดับน้ำ: ");
  Serial.print(waterLevel);
  Serial.println(" cm");

  // ==== แจ้งเตือนระดับน้ำ ====
if (waterLevel >= 190 && !notified190) {
