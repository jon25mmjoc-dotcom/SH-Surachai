      case 3:
        bot.sendMessage(chatID, "🌧️ ขณะนี้ฝนตกหนัก เสี่ยงน้ำท่วมขังในพื้นที่ลุ่มต่ำ โปรดเตรียมป้องกันน้ำเข้าบ้าน ปริมาณน้ำฝน " + String(rainAmount, 1) + " mm.", "");
        break;
      case 4:
        bot.sendMessage(chatID, "⛈️ ขณะนี้ฝนตกหนักมาก! มีโอกาสเกิดน้ำป่าไหลหลากและน้ำท่วมฉับพลัน โปรดหลีกเลี่ยงการเดินทางในพื้นที่เสี่ยง ปริมาณน้ำฝน " + String(rainAmount, 1) + " mm.", "");
        break;
    }
    lastRainLevel = currentRainLevel;
  }

  // ==== ตรวจว่าฝนหยุดตกหรือยัง ====
  if (rainIsFalling && millis() - lastRainClickTime > 30 * 60 * 1000) {
    bot.sendMessage(chatID, "☀️ ขณะนี้ฝนหยุดตกแล้ว", "");
    rainIsFalling = false;
    lastRainLevel = 0;
  }

  // ==== เปิดฝนตกใหม่เมื่อมี click ใหม่ ====
  if (!rainIsFalling && millis() - lastRainClickTime < 30 * 60 * 1000) {
    rainIsFalling = true;
  }

  delay(5000); // วน loop ทุก 5 วินาที
}
